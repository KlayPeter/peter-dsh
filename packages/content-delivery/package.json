{
  "name": "@klaypeter/content-delivery",
  "version": "0.1.1",
  "description": "Agent-guided Chinese document authoring and local Markdown to HTML, PDF and DOCX delivery",
  "type": "module",
  "main": "src/index.js",
  "exports": {".": "./src/index.js", "./dsh": "./src/dsh.js"},
  "bin": {"peter-deliver": "src/cli.js"},
  "files": ["src", "skills", "vendor", "examples", "cordis.patch.yml", "README.md", "THIRD_PARTY.md", "LICENSE"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
  "scripts": {
    "test": "node --test tests/unit.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "setup:browser": "playwright install chromium"
  },
  "engines": {"node": ">=22"},
  "dependencies": {
    "docx": "9.7.1",
    "markdown-it": "15.0.2",
    "mermaid": "12.0.0",
    "playwright": "1.63.0",
    "sharp": "0.34.5"
  },
  "peerDependencies": {"@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0"},
  "peerDependenciesMeta": {"@deepseek-ai/dsh-tools": {"optional": true}},
  "repository": {"type": "git", "url": "git+https://github.com/KlayPeter/peter-dsh.git", "directory": "packages/content-delivery"},
  "keywords": ["agent-skills", "deepseek-harness", "dsh-plugin", "markdown", "pdf", "docx"],
  "license": "MIT"
}
